{
  "name": "lexbharat-local",
  "version": "0.1.0",
  "private": true,
  "description": "LexBharat: a legal-research workspace for Indian law (Acts, judgments, chat, drafting, review, vault). Testing phase; not legal advice.",
  "scripts": {
    "predev": "node scripts/copy-static-data.mjs && node scripts/drafting/build-templates.mjs",
    "dev": "next dev --port 3100",
    "prebuild": "node scripts/copy-static-data.mjs && node scripts/drafting/build-templates.mjs",
    "prestart": "node scripts/copy-static-data.mjs && node scripts/drafting/build-templates.mjs",
    "build": "next build",
    "start": "next start --port 3100",
    "dev:release": "NEXT_PUBLIC_RELEASE=1 next dev --port 3100",
    "build:demo": "NEXT_PUBLIC_RELEASE=0 next build",
    "test:extract": "node --test \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "index:acts-text": "scripts/acts/export-act-text.sh",
    "load:acts-neon": "scripts/acts/load-neon.sh",
    "load:supplement": "node scripts/supplement/load-supplement.mjs",
    "qa:sweep": "node scripts/judgments/qa-sweep.mjs",
    "qa:live": "node --experimental-websocket scripts/judgments/qa-live.mjs",
    "index:hc-search": "node --max-old-space-size=6000 scripts/judgments/build-hc-search-index.mjs",
    "ui-sweep": "node scripts/ui-sweep/sweep.mjs",
    "verify-vectors": "node scripts/verify/dims.mjs && node scripts/verify/model-check.mjs && node scripts/verify/vector-only.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.14.0",
    "lenis": "^1.3.0",
    "mammoth": "^1.13.0",
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "regenerator-runtime": "^0.14.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.0",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.0"
  }
}
