{
  "name": "lexbharat-local",
  "version": "0.1.0",
  "private": true,
  "description": "LexBharat local build: an educational homepage recreation with placeholder assets and a MOCK backend only.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "dev:release": "NEXT_PUBLIC_RELEASE=1 next dev --port 3100",
    "build:demo": "NEXT_PUBLIC_RELEASE=0 next build",
    "test:extract": "node --test src/lib/judgments/extract.test.mjs src/lib/judgments/hcSearchCore.test.mjs src/lib/acts/reassemble.test.mjs",
    "index:acts-text": "scripts/acts/export-act-text.sh",
    "qa:sweep": "node scripts/judgments/qa-sweep.mjs",
    "qa:live": "node --experimental-websocket scripts/judgments/qa-live.mjs",
    "index:hc-search": "node --max-old-space-size=6000 scripts/judgments/build-hc-search-index.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.0"
  }
}
