# LexBharat environment variables. Copy to .env.local and fill in. NEVER commit real values (.env*.local is git-ignored).
# On Vercel set the same names for Production and, if you want to test a branch, for Preview.

# --- Access gate (the whole app is behind a password; in production a missing ACCESS_PASSWORD closes the site) ---
ACCESS_PASSWORD=
ACCESS_COOKIE_SECRET=          # long random string that signs the access cookie
ADMIN_PASSWORD=                # for /admin/insights

# --- Main database: Acts, chats, drafts, reviews (Neon Postgres) ---
DATABASE_URL=

# --- Search by meaning (Neon with the pgvector extension; tables created by the scripts in scripts/acts and scripts/w10) ---
VECTOR_DATABASE_URL=                 # Central and State Acts
VECTOR_DATABASE_URL_REGULATORY=      # regulator instruments
VECTOR_DATABASE_URL_SC=              # Supreme Court judgments

# --- Regulator and Supreme Court judgment text (separate free Neon projects, loaded by scripts/w10) ---
REG_DATABASE_URL=
SC_DATABASE_URL=
SC_KEYWORD_DATABASE_URL=

# --- Supabase: Vault files and text, feedback, usage counters, rate limits ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
VAULT_BUCKET=

# --- AI providers ---
GEMINI_API_KEY=                # answers, drafting, review, scan reading
VOYAGE_API_KEY=                # embeddings (voyage-4, 256 dimensions); the free tier allows 3 requests a minute
# Optional: other model providers through the provider layer (src/lib/ai)
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=
LITELLM_API_KEY=

# --- Local-only data folders (not needed on Vercel) ---
JUDGMENTS_DATA_DIR=            # exported High Court case pages and the SC previews, e.g. ../lexbharat-data/judgments-hc
JUDGMENTS_DATA_URL=            # the same files served from object storage (not set up yet)
ACTS_TEXT_DATA_DIR=            # per-Act text files, e.g. ../lexbharat-data/acts-text

# --- Optional ---
NEXT_PUBLIC_RELEASE=           # 1 hides the dev/demo annotations of the first build (set by .env.production / .env.development)
VAULT_MAX_DOCS=
VAULT_MAX_FILE_MB=
VAULT_MAX_TOTAL_MB=
